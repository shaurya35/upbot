{
  "name": "upbot",
  "private": true,
  "scripts": {
    "dev": "bun scripts/dev-setup.ts && turbo run dev",
    "db:setup": "bun scripts/dev-setup.ts",
    "db:push": "bun --env-file=.env run --cwd packages/store db:push",
    "services:down": "docker compose down",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.11.7",
    "typescript": "5.8.3",
    "@types/bun": "^1.3.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
