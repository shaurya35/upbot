generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String           @id @default(uuid())
  email             String           @unique
  password          String?
  name              String?
  company           String?
  signupMethod      String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  emailVerified     DateTime?
  websites          Website[]
  alertChannels     AlertChannel[]
  deletedAt         DateTime?
}

model OtpVerification {
  id                String          @id @default(uuid())
  email             String          @unique
  otp               String
  expiresAt         DateTime
  attempts          Int             @default(0)
  createdAt         DateTime        @default(now())
}

model Website {
  id                String           @id @default(uuid())
  url               String      
  name              String          
  userId            String       
  user              User             @relation(fields: [userId], references: [id])
  
  monitorInterval   Int              @default(60)  
  
  checks            Check[]         
  incidents         Incident[]
  incidentState     IncidentState?
  alertChannels     AlertChannel[]  
  regions           Region[]         @relation("WebsiteRegions") 
  
  createdAt         DateTime         @default(now())
  deletedAt         DateTime?      
  
  @@index([userId])
}

model Check {
  observationKey    String?          @unique
  id                String           @id @default(uuid())
  
  websiteId         String           
  website           Website          @relation(fields: [websiteId], references: [id])
  regionId          String           
  region            Region           @relation(fields: [regionId], references: [id])
  
  status            CheckStatus      @default(UNKNOWN) 
  responseTime      Int           
  statusCode        Int?             
  error             String?         
  
  createdAt         DateTime         @default(now())  
  
  @@index([websiteId, createdAt])
  @@index([createdAt])  
}

model Region {
  id                String           @id @default(uuid())
  code              String           @unique
  name              String        
  provider          RegionProvider   @default(CLOUDFLARE)

  checks            Check[]
  websites          Website[]        @relation("WebsiteRegions")
}

model AlertChannel {
  id                String           @id @default(uuid())
  type              AlertType       
  userId            String           
  user              User             @relation(fields: [userId], references: [id])
  
  webhookUrl        String?          
  email             String?         
  phone             String?        
  isActive          Boolean          @default(true)
  
  websites          Website[]
  deliveries        WebhookDelivery[]
  
  createdAt         DateTime         @default(now())
}

enum CheckStatus {
  UP
  DOWN
  UNKNOWN
}

enum RegionProvider {
  CLOUDFLARE  
}

enum AlertType {
  EMAIL
  SMS
  DISCORD
  SLACK
  WEBHOOK
  TELEGRAM
}

model IncidentState {
  websiteId       String @id
  website         Website @relation(fields: [websiteId], references: [id])
  lastObservedAt  DateTime?
  consecutiveDown Int @default(0)
  firstDownAt     DateTime?
  firstDownReason String?
}

model Incident {
  id          String @id @default(uuid())
  websiteId   String
  website     Website @relation(fields: [websiteId], references: [id])
  startedAt   DateTime
  recoveredAt DateTime?
  reason      String?
  deliveries  WebhookDelivery[]
  @@index([websiteId, startedAt])
}

model WebhookDelivery {
  id          String @id @default(uuid())
  incidentId  String
  incident    Incident @relation(fields: [incidentId], references: [id])
  channelId   String
  channel     AlertChannel @relation(fields: [channelId], references: [id])
  eventType   String
  occurredAt  DateTime
  status      String @default("PENDING")
  attempts    Int @default(0)
  nextAttempt DateTime @default(now())
  createdAt   DateTime @default(now())
  @@unique([incidentId, channelId, eventType])
  @@index([status, nextAttempt])
}
