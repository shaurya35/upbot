      "text": "model AlertChannel {\n  id                String           @id\n@default(uuid())\n  type              AlertType       \n  userId            String           \n  user              User\n@relation(fields: [userId], references:\n[id])\n  \n  webhookUrl        String?          \n  email             String?         \n  phone             String?        \n  isActive          Boolean\n@default(true)\n  \n  websites          Website[]       \n  \n  createdAt         DateTime\n@default(now())\n}",
