      "versionNonce": 330995212,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762873233617,
      "link": null,
      "locked": false,
      "text": "Issues in v3: \n2. No deleting logic\nSol- create a delete worker\n   deletes acc to plan",
