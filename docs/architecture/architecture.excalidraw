      "seed": 1826291484,
      "version": 142,
      "versionNonce": 544875572,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762873233617,
      "link": null,
      "locked": false,
      "text": "acknowledgement\n",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "acknowledgement\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "VOjRMxoSnX0zxq-cNKnUl",
      "type": "text",
      "x": 5164.959577819365,
      "y": 1364.3855847672482,
      "width": 871.199462890625,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGx",
      "roundness": null,
      "seed": 664682780,
      "version": 159,
      "versionNonce": 1456498956,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762873233617,
      "link": null,
      "locked": false,
      "text": "Pusher -> high performance persistent queues\n       -> xAddBulk\n\nWorker -> calls cf workers\n       -> xAckBulk",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pusher -> high performance persistent queues\n       -> xAddBulk\n\nWorker -> calls cf workers\n       -> xAckBulk",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "-jIJ3OzIl6DwiqgFxU8BO",
      "type": "text",
      "x": 5154.3405302003175,
      "y": 1969.1236800053439,
      "width": 1227.59912109375,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGy",
      "roundness": null,
      "seed": 673745948,
      "version": 470,
      "versionNonce": 193953204,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762873233617,
      "link": null,
      "locked": false,
      "text": "Technical Challenges solved: \n1. Scalability - scheduler is in redis memory\n               - Hashtable - < Key, value > \n               - O(1) - lookup, inserts, delete\n               - pusher and worker - lightweight\n2. Acknowledgement - if worker creashes, streams holds the job\n3. DB Performance",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Technical Challenges solved: \n1. Scalability - scheduler is in redis memory\n               - Hashtable - < Key, value > \n               - O(1) - lookup, inserts, delete\n               - pusher and worker - lightweight\n2. Acknowledgement - if worker creashes, streams holds the job\n3. DB Performance",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "AV3BUqgzapP0r12VhGY3R",
      "type": "text",
      "x": 6466.340530200318,
      "y": 1534.6236800053434,
      "width": 752.3995361328125,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGz",
      "roundness": null,
      "seed": 2019287836,
      "version": 525,
      "versionNonce": 1433888652,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762873233617,
      "link": null,
      "locked": false,
      "text": "Issues in v1: \n1. scaling from 100k sites -> 1M sites\n   pusher is single point of failure\nSol- make multiple streams \nupbot:schedule:1, upbot:schedule:2",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Issues in v1: \n1. scaling from 100k sites -> 1M sites\n   pusher is single point of failure\nSol- make multiple streams \nupbot:schedule:1, upbot:schedule:2",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "4lsqJj_I233IoM9BICEXx",
      "type": "text",
      "x": 7791.340530200318,
      "y": 1524.6236800053434,
      "width": 752.3995361328125,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGzV",
      "roundness": null,
      "seed": 173764900,
      "version": 680,
      "versionNonce": 1841145652,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762873233617,
      "link": null,
      "locked": false,
      "text": "Issues in v1: \n2. scaling from 100k sites -> 1M sites\n   db query can still crash\nSol- use timeseries db",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Issues in v1: \n2. scaling from 100k sites -> 1M sites\n   db query can still crash\nSol- use timeseries db",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "tA-4p4ksXLB-U-GTqvl_U",
      "type": "text",
      "x": 7786.340530200318,
      "y": 1952.1236800053434,
      "width": 534.5996704101562,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
