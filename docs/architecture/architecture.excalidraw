      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Issues in v3: \n2. No deleting logic\nSol- create a delete worker\n   deletes acc to plan",
      "autoResize": true,
      "lineHeight": 1.25
    },
